<!doctype html>
<html>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Telephone Directory</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <div class="container">
    <h1>Telephone Directory</h1>

    <section id="form-section">
      <h2 id="form-title">Create</h2>
      <form id="entry-form">
        <input type="hidden" id="entry-id" />
        <label>Nama_User<br><input id="Nama_User" required></label><br>
        <label>Alamat<br><input id="Alamat"></label><br>
        <label>No_Telp<br><input id="No_Telp"></label><br>
        <label>kode_post<br><input id="kode_post"></label><br>
        <label>date_time<br><input id="date_time" type="datetime-local"></label><br>
        <button type="submit">Save</button>
        <button type="button" id="form-cancel">Cancel</button>
      </form>
    </section>

    <section id="list-section">
      <h2>Entries</h2>
      <div id="loading">Loading...</div>
      <table id="items-table" class="hidden">
        <thead><tr><th>Id</th><th>Nama</th><th>Alamat</th><th>Telp</th><th>kode_post</th><th>date_time</th><th>Actions</th></tr></thead>
        <tbody id="items-body"></tbody>
      </table>
    </section>
  </div>
  <script src="/app.js"></script>
</body>
</html>
